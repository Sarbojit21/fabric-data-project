      {
        "type": "Script",
        "typeProperties": {
          "database": "GLOBAL_EDW_DSP",
          "scripts": [
            {
              "text": {
                "value": "UPDATE tgt\nSET tgt.[Reference_Document_Type] = src.AWTYP\nFROM GLOBAL_EDW_DSP.GLOBAL_EDW.EDW_T_F_PRD_SERVCST_CUR_D tgt\nJOIN ECC_CORE.ECC_CORE.COBK src\n    ON tgt.DOCMT_NUM = src.BELNR\n   AND tgt.CONTROLLING_AREA = src.KOKRS\n   AND tgt.[FISCAL_YR] = src.GJAHR;",
                "type": "Expression"
              },
              "type": "Query"
            }
          ],
          "scriptBlockExecutionTimeout": "02:00:00"
        },
        "externalReferences": {
          "connection": "1686fadf-6a00-4f2d-a907-62292b950d1b"
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Reference_Document_Type",
        "dependsOn": []
      },
      {
        "type": "Script",
        "typeProperties": {
          "database": "GLOBAL_EDW_DSP",
          "scripts": [
            {
              "text": {
                "value": "WITH SRC AS\r\n(\r\nSELECT DISTINCT \r\n     RCLNT\r\n    ,RYEAR\r\n    ,OBJNR00\r\n    ,OBJNR01\r\n    ,OBJNR02\r\n    ,OBJNR03\r\n    ,OBJNR04\r\n    ,OBJNR05\r\n    ,OBJNR06\r\n    ,OBJNR07\r\n    ,OBJNR08\r\n    ,RPMAX\r\n    ,DRCRK\r\n\t,HSLVT\r\n\t,RCNTR\r\n    ,CAST(REPLACE(PERIOD_COL,'TSL','') AS INT) AS PSTNG_PER\r\n    ,TRNSCTN_CRNCY_AMT\r\nFROM\r\n(\r\n    SELECT\r\n         RCLNT\r\n        ,RYEAR\r\n        ,OBJNR00\r\n        ,OBJNR01\r\n        ,OBJNR02\r\n        ,OBJNR03\r\n        ,OBJNR04\r\n        ,OBJNR05\r\n        ,OBJNR06\r\n        ,OBJNR07\r\n        ,OBJNR08\r\n        ,RPMAX\r\n        ,DRCRK\r\n\t\t,HSLVT\r\n\t\t,RCNTR\r\n        ,TSL01,TSL02,TSL03,TSL04\r\n        ,TSL05,TSL06,TSL07,TSL08\r\n        ,TSL09,TSL10,TSL11,TSL12\r\n        ,TSL13,TSL14,TSL15,TSL16\r\n    FROM ECC_CORE.ECC_CORE.FAGLFLEXT\r\n) S\r\nUNPIVOT\r\n(\r\n    TRNSCTN_CRNCY_AMT FOR PERIOD_COL IN\r\n    (\r\n        TSL01,TSL02,TSL03,TSL04,\r\n        TSL05,TSL06,TSL07,TSL08,\r\n        TSL09,TSL10,TSL11,TSL12,\r\n        TSL13,TSL14,TSL15,TSL16\r\n    )\r\n) U\r\n)\r\n \r\nUPDATE T\r\nSET T.OPENING_BAL = SRC.HSLVT,\r\n  T.COST_CNTR_ID = SRC.RCNTR\r\nFROM GLOBAL_EDW_DSP.GLOBAL_EDW.EDW_T_F_FI_GENLDGT2_CUR_D T\r\nINNER JOIN SRC\r\n     ON     T.FISCAL_YR             = SRC.RYEAR\r\n        AND T.TBL_GROUP_OBJ_NUM_00  = SRC.OBJNR00\r\n        AND T.TBL_GROUP_OBJ_NUM_01  = SRC.OBJNR01\r\n        AND T.TBL_GROUP_OBJ_NUM_02  = SRC.OBJNR02\r\n        AND T.TBL_GROUP_OBJ_NUM_03  = SRC.OBJNR03\r\n        AND T.TBL_GROUP_OBJ_NUM_04  = SRC.OBJNR04\r\n        AND T.TBL_GROUP_OBJ_NUM_05  = SRC.OBJNR05\r\n        AND T.TBL_GROUP_OBJ_NUM_06  = SRC.OBJNR06\r\n        AND T.TBL_GROUP_OBJ_NUM_07  = SRC.OBJNR07\r\n        AND T.TBL_GROUP_OBJ_NUM_08  = SRC.OBJNR08\r\n        AND T.MAX_PER               = SRC.RPMAX\r\n        AND T.DEBIT_CREDIT_IND      = SRC.DRCRK\r\n        AND T.PSTNG_PER\t\t\t\t= SRC.PSTNG_PER\r\n        AND T.TRNSCTN_CRNCY_AMT     = SRC.TRNSCTN_CRNCY_AMT",
                "type": "Expression"
              },
              "type": "Query"
            }
          ],
          "scriptBlockExecutionTimeout": "02:00:00"
        },
        "externalReferences": {
          "connection": "1686fadf-6a00-4f2d-a907-62292b950d1b"
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "OPENING_BAL",
        "dependsOn": []
      },
      {
        "type": "Script",
        "typeProperties": {
          "database": "GLOBAL_EDW_DSP",
          "scripts": [
            {
              "text": {
                "value": "UPDATE F SET\n\n    F.SERV_ORD_DESC_UNICODED = S.KTEXT \n\nFROM [GLOBAL_EDW].[EDW_T_D_PRD_SERVORD_CUR_D]AS F\n\nLEFT JOIN [ECC_CORE].[ECC_CORE].[AUFK] AS S\n\n    ON F.[SERVC_ORDER] = S.AUFNR \n\nWHERE  F.[DESC] LIKE '%\u001a\u001a%'",
                "type": "Expression"
              },
              "type": "Query"
            }
          ],
          "scriptBlockExecutionTimeout": "02:00:00"
        },
        "externalReferences": {
          "connection": "1686fadf-6a00-4f2d-a907-62292b950d1b"
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "SERV_ORD_DESC_UNICODED",
        "dependsOn": []
      }
    ]
  }
