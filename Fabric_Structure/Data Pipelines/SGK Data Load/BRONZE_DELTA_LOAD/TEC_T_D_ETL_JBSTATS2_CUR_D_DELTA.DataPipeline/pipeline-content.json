            "sqlReaderQuery": {
              "value": "SELECT \n    CT.SYS_CHANGE_VERSION,\n    CT.SYS_CHANGE_CREATION_VERSION,\n    CT.SYS_CHANGE_OPERATION,\n    CT.SYS_CHANGE_COLUMNS,\n    CT.SYS_CHANGE_CONTEXT,\n\t\n    CT.SequenceID AS CT_SequenceID,\n \n    F.*\n \nFROM CHANGETABLE(CHANGES [GLOBAL_EDW].[TEC_T_D_ETL_JBSTATS2_CUR_D],\n    @{activity('LookupOld').output.firstRow.SYS_CHANGE_VERSION}) CT\n\nINNER JOIN \n    (\n        SELECT \n            MAX(E.SYS_CHANGE_VERSION) AS SYS_CHANGE_VERSION,\n            E.SequenceID\n        FROM CHANGETABLE(CHANGES [GLOBAL_EDW].[TEC_T_D_ETL_JBSTATS2_CUR_D],\n\t\t    @{activity('LookupOld').output.firstRow.SYS_CHANGE_VERSION}) E\n        GROUP BY SequenceID\n    ) b\n    ON CT.SequenceID = b.SequenceID\n    AND CT.SYS_CHANGE_VERSION = b.SYS_CHANGE_VERSION\n \nLEFT JOIN [GLOBAL_EDW].[TEC_T_D_ETL_JBSTATS2_CUR_D] F\n    ON CT.SequenceID = F.SequenceID\nWHERE ISNULL(CT.[SYS_CHANGE_VERSION],'') > ''\n        AND CT.SYS_CHANGE_OPERATION <> 'D'\n\t    AND ISNULL(CT.SYS_CHANGE_VERSION,0) <= @{activity('LookupNew').output.firstRow.SYS_CHANGE_VERSION}",
