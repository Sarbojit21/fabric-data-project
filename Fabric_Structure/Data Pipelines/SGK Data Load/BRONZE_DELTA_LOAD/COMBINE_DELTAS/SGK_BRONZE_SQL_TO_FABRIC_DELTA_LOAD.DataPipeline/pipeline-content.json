                "value": "WITH SRC AS\n\n(\n\nSELECT DISTINCT \n\n     RCLNT\n\n    ,RYEAR\n\n    ,OBJNR00\n\n    ,OBJNR01\n\n    ,OBJNR02\n\n    ,OBJNR03\n\n    ,OBJNR04\n\n    ,OBJNR05\n\n    ,OBJNR06\n\n    ,OBJNR07\n\n    ,OBJNR08\n\n    ,RPMAX\n\n    ,DRCRK\n\n\t,HSLVT\n\n\t,RCNTR\n\n    ,CAST(REPLACE(PERIOD_COL,'TSL','') AS INT) AS PSTNG_PER\n\n    ,TRNSCTN_CRNCY_AMT\n\nFROM\n\n(\n\n    SELECT\n\n         RCLNT\n\n        ,RYEAR\n\n        ,OBJNR00\n\n        ,OBJNR01\n\n        ,OBJNR02\n\n        ,OBJNR03\n\n        ,OBJNR04\n\n        ,OBJNR05\n\n        ,OBJNR06\n\n        ,OBJNR07\n\n        ,OBJNR08\n\n        ,RPMAX\n\n        ,DRCRK\n\n\t\t,HSLVT\n\n\t\t,RCNTR\n\n        ,TSL01,TSL02,TSL03,TSL04\n\n        ,TSL05,TSL06,TSL07,TSL08\n\n        ,TSL09,TSL10,TSL11,TSL12\n\n        ,TSL13,TSL14,TSL15,TSL16\n\n    FROM ECC_CORE.ECC_CORE.FAGLFLEXT\n\n) S\n\nUNPIVOT\n\n(\n\n    TRNSCTN_CRNCY_AMT FOR PERIOD_COL IN\n\n    (\n\n        TSL01,TSL02,TSL03,TSL04,\n\n        TSL05,TSL06,TSL07,TSL08,\n\n        TSL09,TSL10,TSL11,TSL12,\n\n        TSL13,TSL14,TSL15,TSL16\n\n    )\n\n) U\n\n)\n\n \n\nUPDATE T\n\nSET T.OPENING_BAL = SRC.HSLVT,\n\n  T.COST_CNTR_ID = SRC.RCNTR\n\nFROM GLOBAL_EDW_DSP.GLOBAL_EDW.EDW_T_F_FI_GENLDGT2_CUR_D T\n\nINNER JOIN SRC\n\n     ON     T.FISCAL_YR             = SRC.RYEAR\n\n        AND T.TBL_GROUP_OBJ_NUM_00  = SRC.OBJNR00\n\n        AND T.TBL_GROUP_OBJ_NUM_01  = SRC.OBJNR01\n\n        AND T.TBL_GROUP_OBJ_NUM_02  = SRC.OBJNR02\n\n        AND T.TBL_GROUP_OBJ_NUM_03  = SRC.OBJNR03\n\n        AND T.TBL_GROUP_OBJ_NUM_04  = SRC.OBJNR04\n\n        AND T.TBL_GROUP_OBJ_NUM_05  = SRC.OBJNR05\n\n        AND T.TBL_GROUP_OBJ_NUM_06  = SRC.OBJNR06\n\n        AND T.TBL_GROUP_OBJ_NUM_07  = SRC.OBJNR07\n\n        AND T.TBL_GROUP_OBJ_NUM_08  = SRC.OBJNR08\n\n        AND T.MAX_PER               = SRC.RPMAX\n\n        AND T.DEBIT_CREDIT_IND      = SRC.DRCRK\n\n        AND T.PSTNG_PER\t\t\t\t= SRC.PSTNG_PER\n\n        AND T.TRNSCTN_CRNCY_AMT     = SRC.TRNSCTN_CRNCY_AMT",
                "type": "Expression"
