            "sqlReaderQuery": {
              "value": "SELECT DISTINCT \n\t\tISNULL(MAX(CT.SYS_CHANGE_VERSION),0) AS SYS_CHANGE_VERSION\t   \nFROM CHANGETABLE(CHANGES [GLOBAL_EDW].[SAU_T_D_SAL_SALORDH_CUR_D],0) CT\nLEFT JOIN [GLOBAL_EDW].[SAU_T_D_SAL_SALORDH_CUR_D] F\nON CT.SALES_ORDER_KEY        = F.SALES_ORDER_KEY\nWHERE ISNULL(CT.[SYS_CHANGE_VERSION],'') > ''",
